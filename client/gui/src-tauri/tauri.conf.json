{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeC Tier",
  "version": "0.2.0",
  "identifier": "app.freectier.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FreeC Tier",
      "theme": "Dark",
      "width": 1060,
      "height": 720,
      "minWidth": 720,
      "minHeight": 520,
      "decorations": false,
      "shadow": true,
      "visible": false,
      "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-extensions --disable-breakpad --disable-background-networking --js-flags=--max-old-space-size=96"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": { "active": false }
}
